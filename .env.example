# Copy to .env (never commit .env) and fill in ONE provider.

# groq | gemini | ollama | none   (empty = auto-detect from the keys below)
LLM_PROVIDER=groq

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (model names change; check the provider's model list)
# LLM_MODEL=llama-3.1-8b-instant
# LLM_TIMEOUT=30
# OLLAMA_HOST=http://localhost:11434

# Retrieval / RAG settings
# RAG_INDEX_DIR=data/rag_index
# RAG_USE_RERANKER=1
# RAG_MIN_CONFIDENCE=        # override the calibrated refusal threshold
